# Cloudflare Pages redirects.
# Route bare "/" to /en/.
# ★302だとGoogleが「/ が正、/en/ は重複」と解釈し、ホームの canonical を
#   / に選んでいた(URL Inspection APIで確認 2026-08-04)。301で /en/ を確定させる。
#   locale自動判定を将来入れる場合もCDN側の書き換えで対応できる。
/ /en/ 301

# Exclude static files from locale redirect (must come before /:locale rule)
/sitemap.xml /sitemap.xml 200
/llms.txt /llms.txt 200
/robots.txt /robots.txt 200
/ads.txt /ads.txt 200
/googleada2940b448e1d03.html /googleada2940b448e1d03.html 200
/505118c2333ec1cbddc87177c90a0dce.txt /505118c2333ec1cbddc87177c90a0dce.txt 200
/1af6def058a64ef42dbe4201c61dfd4a0ff2c19adf0144fe3fc2da35007db341.txt /1af6def058a64ef42dbe4201c61dfd4a0ff2c19adf0144fe3fc2da35007db341.txt 200
/feed.xml /feed.xml 200
/feed-ja.xml /feed-ja.xml 200
/og/* /og/:splat 200
/images/* /images/:splat 200
/web-stories/* /web-stories/:splat 200

# 旧 /:locale/under-<N>/ は部分動的セグメントのバグでソフト404だった(2026-07-29修正)。
# 正規ルート /:locale/under/<N>/ へ301。
# サイトは trailingSlash:true なので、Googleが持っているのは末尾スラッシュ付きの形。
# 両方書かないと片方が旧ファイル(ソフト404)のまま残る。
/:locale/under-50/ /:locale/under/50/ 301
/:locale/under-100/ /:locale/under/100/ 301
/:locale/under-200/ /:locale/under/200/ 301
/:locale/under-500/ /:locale/under/500/ 301
/:locale/under-50 /:locale/under/50/ 301
/:locale/under-100 /:locale/under/100/ 301
/:locale/under-200 /:locale/under/200/ 301
/:locale/under-500 /:locale/under/500/ 301

# Strip trailing-slash duplicates handled by Next config; this catches edges.
/:locale /:locale/ 301
